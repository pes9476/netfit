POSTGRES_DB=netfit
POSTGRES_USER=netfit_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Railway / production
# Supabase Dashboard > Connect > Session pooler URI (?sslmode=require 권장)
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
DJANGO_SECURE_HSTS_SECONDS=3600
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://your-app.up.railway.app/login/kakao/callback/
