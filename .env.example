# Local development: copy to .env. Never commit real secrets.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Render/Railway: DEBUG=False and a new random SECRET_KEY are required.
# SECRET_KEY=generate-a-new-random-secret
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Render production example (platform domain is also detected automatically):
# ALLOWED_HOSTS=netfit-production.onrender.com
# CSRF_TRUSTED_ORIGINS=https://netfit-production.onrender.com
# Railway volume mounted at /data:
# MEDIA_ROOT=/data/media
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://netfit-production.onrender.com/login/kakao/callback/
# Optional local PostgreSQL alternative to DATABASE_URL:
# POSTGRES_DB=netfit
# POSTGRES_USER=netfit_user
# POSTGRES_PASSWORD=your-local-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
