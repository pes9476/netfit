# Local development: copy to .env. Never commit real secrets.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Render: DEBUG=False and a new random SECRET_KEY are required.
# SECRET_KEY=generate-a-new-random-secret
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Custom domains:
# ALLOWED_HOSTS=netfit.example.com
# CSRF_TRUSTED_ORIGINS=https://netfit.example.com
# Persistent disk mounted at /data:
# MEDIA_ROOT=/data/media
# Render automatically provides RENDER and RENDER_EXTERNAL_HOSTNAME.
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://YOUR-DOMAIN/login/kakao/callback/
# Fitbot Gemini API (create a key in Google AI Studio):
# GEMINI_API_KEY=
# GOOGLE_API_KEY=  # optional alias for GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
# Optional local PostgreSQL alternative to DATABASE_URL:
# POSTGRES_DB=netfit
# POSTGRES_USER=netfit_user
# POSTGRES_PASSWORD=your-local-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
